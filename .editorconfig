# Editor settings: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,s,S,lua}]
indent_style = tab
indent_size = 8

[{Makefile,*.mk}]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[{justfile,*.sh,*.yml,*.yaml,*.toml,*.md,*Dockerfile,.clang-format,.clangd}]
indent_style = space

[*.sh]
indent_size = 2

[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset

# Vendored FatFs, kept as upstream wrote it
[source/ff15/**]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

# Windows scripts from EZ-Flash's official source keep CRLF
[*.bat]
charset = unset
end_of_line = crlf

# EZ-Flash's emulator sources mix CRLF and LF files
[emusrc/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
