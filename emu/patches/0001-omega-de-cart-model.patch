+#ifndef GBA_CART_OMEGA_H
+#define GBA_CART_OMEGA_H
+
+#include <mgba-util/common.h>
+
+CXX_GUARD_START
+
+#include <mgba/core/log.h>
+
+mLOG_DECLARE_CATEGORY(GBA_OMEGA);
+
+// Model of the EZ-Flash Omega Definitive Edition cart, as driven by its
+// open-source kernel: register unlock, kernel/game NOR, PSRAM, SD card,
+// FPGA ROM loading and banked SRAM. Enabled with the "omega.dir" config
+// value (or OMEGA_DIR), a folder holding the cart's backing files.
+
+#define OMEGA_KERNEL_NOR_SIZE 0x00800000
+#define OMEGA_GAME_NOR_SIZE 0x04000000
+#define OMEGA_PSRAM_SIZE 0x02000000
+#define OMEGA_SRAM_SIZE 0x00080000
+#define OMEGA_PORT_SIZE 0x1000
+
+enum GBAOmegaNorState {
+	OMEGA_NOR_READ = 0,
+	OMEGA_NOR_UNLOCK1,
+	OMEGA_NOR_UNLOCK2,
+	OMEGA_NOR_ERASE_UNLOCK0,
+	OMEGA_NOR_ERASE_UNLOCK1,
+	OMEGA_NOR_ERASE_UNLOCK2,
+	OMEGA_NOR_PROGRAM,
+	OMEGA_NOR_AUTOSELECT,
+	OMEGA_NOR_BUFFER_COUNT,
+	OMEGA_NOR_BUFFER_DATA,
+};
+
+struct GBAOmegaNor {
+	uint8_t* data;
+	size_t size;
+	uint16_t id;
+	enum GBAOmegaNorState state;
+	uint32_t bufferBase;
+	int bufferRemaining;
+	struct VFile* vf;
+};
+
+struct GBA;
+struct VFile;
+
+struct GBAOmega {
+	bool enabled;
+
+	struct GBAOmegaNor kernelNor;
+	struct GBAOmegaNor gameNor;
+	uint8_t* psram;
+	uint8_t* sram;
+	struct VFile* sramVf;
+	struct VFile* sd;
+
+	int unlockStep;
+	bool unlocked;
+	uint16_t sdControl;
+	uint16_t bufferControl;
+	uint16_t spiControl;
+	uint16_t spiWrite;
+	uint16_t rtcStatus;
+	uint16_t ledControl;
+	uint16_t rom64Flag;
+	uint16_t psramPage;
+	uint16_t romPage;
+	uint16_t ramPage;
+	uint32_t sdLba;
+	int flashCmdStep;
+
+	// Save type and size the kernel sent for the next game (FAT table
+	// parameter word 0x1FC: type << 24 | size).
+	uint8_t saveMode;
+	uint32_t saveSize;
+	uint32_t gameSize;
+	// True while a game runs with mGBA's savedata emulating its save chip;
+	// its contents go back into the cart SRAM at power-off.
+	bool gameSaveActive;
+	// GPIO pins (RTC) overlaid on ROM 0xC4-0xC9, kept apart from the ROM data.
+	uint16_t gpio[4];
+
+	// OMEGA_TRACE=1: log cart events to stderr. rtcTraced keeps the clock
+	// from being logged more than once per game launch.
+	bool trace;
+	bool rtcTraced;
+
+	uint8_t port[OMEGA_PORT_SIZE];
+
+	uint32_t* originalRom;
+	size_t originalRomSize;
+	uint32_t originalRomMask;
+};
+
+void GBAOmegaInit(struct GBAOmega*);
+bool GBAOmegaEnable(struct GBA*, const char* dir);
+void GBAOmegaDisable(struct GBA*);
+
+uint16_t GBAOmegaRead16(struct GBA*, uint32_t address);
+void GBAOmegaWrite16(struct GBA*, uint32_t address, uint16_t value);
+bool GBAOmegaOwnsSRAM(const struct GBA*);
+
+// Save states: the cart's registers, data port, PSRAM (up to its last used
+// byte) and SRAM. The NOR chips and SD card are the cart's disks and stay as
+// they are, like the files of a real card would.
+struct mStateExtdataItem;
+bool GBAOmegaSerialize(const struct GBA*, struct mStateExtdataItem*);
+bool GBAOmegaDeserialize(struct GBA*, const struct mStateExtdataItem*);
+uint8_t GBAOmegaReadSRAM(struct GBA*, uint32_t address);
+void GBAOmegaWriteSRAM(struct GBA*, uint32_t address, uint8_t value);
+
+CXX_GUARD_END
+
+#endif
