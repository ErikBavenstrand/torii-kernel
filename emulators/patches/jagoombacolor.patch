diff --git a/src/equates.h b/src/equates.h
index a2f9bee..a46b388 100644
--- a/src/equates.h
+++ b/src/equates.h
@@ -205,6 +205,33 @@ RECENT_TILENUM_SIZE = 128
 @ Next = _FF41_PC_4
 
 
+@Torii: hi-colour GBC (lcd.s hc_*): per frame, the BG palettes as they
+@stood at line 0 and the colours written to them during the visible lines
+@(one word each: line<<24 | GBA palette offset<<16 | colour), replayed at
+@each GBA line by an HBlank interrupt. Three buffers (hc_swap), each the
+@list's end, the line 0 palettes (64 bytes), a guard word, HC_ENTRIES
+@entries and the end mark.
+ HC_ENTRIES = 768
+ HC_BUF_SIZE = 4 + 64 + 4 + HC_ENTRIES*4 + 4
+ HC_BUF1 = Next - HC_BUF_SIZE
+ HC_BUF2 = HC_BUF1 - HC_BUF_SIZE
+ HC_BUF3 = HC_BUF2 - HC_BUF_SIZE
+ HC_GAMMA = HC_BUF3 - 64	@32 halfwords: a gamma-converted grey per level
+ HC_VARS = HC_GAMMA - 48
+ gbc_palette2 = HC_VARS - 128	@Torii: these two moved from IWRAM, to make room for hc_hblank
+ gbc_palette = gbc_palette2 - 128	@CGB $FF68-$FF6D
+ Next = gbc_palette
+@HC_VARS offsets
+ HC_REC = 0		@the buffer recording this frame
+ HC_REC_PTR = 4		@its next free entry
+ HC_REC_END = 8		@past its last entry (the end mark's slot)
+ HC_READY = 12		@a finished frame's, for the next VBlank (or 0)
+ HC_SHOWN = 16		@the one on the screen
+ HC_SPARE = 20		@the third, while none is ready (or 0)
+ HC_GAMMA_FOR = 24	@the gamma value HC_GAMMA was made for (byte)
+ HC_MAX = 28		@the most entries a frame has had
+ HC_FULL = 32		@frames that ran out of entries
+
  MULTIBOOT_LIMIT	= Next	@How much data is left for Multiboot to work.
  END_OF_EXRAM = MULTIBOOT_LIMIT
 
