+#if RTCSUPPORT
+    char *s=str+20;
+    int timer,mod;
+
+	if(rtc)
+    {
+	strcpy(str,"                    00:00:00");
+	timer=gettime();
+	mod=(timer>>4)&3;				//Hours.
+	*(s++)=(mod+'0');
+	mod=(timer&15);
+	*(s++)=(mod+'0');
+	s++;
+	mod=(timer>>12)&15;				//Minutes.
+	*(s++)=(mod+'0');
+	mod=(timer>>8)&15;
+	*(s++)=(mod+'0');
+	s++;
+	mod=(timer>>20)&15;				//Seconds.
+	*(s++)=(mod+'0');
+	mod=(timer>>16)&15;
+	*(s++)=(mod+'0');
+
+	drawtext(0,str,0);
+    }
+#endif
+}
