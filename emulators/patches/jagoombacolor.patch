diff --git a/src/torii_cheats.c b/src/torii_cheats.c
new file mode 100644
index 0000000..b1fef7c
--- /dev/null
+++ b/src/torii_cheats.c
@@ -0,0 +1,56 @@
+#include "includes.h"
+
+// Torii: the RAM writes the kernel's cheat screen picked (source/cheatemu.h,
+// struct torii_cheats): GameShark codes. A const block the kernel finds in its
+// copy of this emulator by its magic and fills in PSRAM after copying the
+// emulator there (the emulator runs in place from PSRAM, so it reads the table
+// at once). The kernel's copy keeps count 0. volatile: the compiler may not
+// fold the count to the 0 it is built with.
+struct torii_cheat {
+	u8 kind;  // 1: a poke
+	u8 bank;  // WRAM bank for D000-DFFF: 0 the one mapped now, 1-7
+	u16 addr;  // C000-DFFF, E000-FDFF (the echo), FF80-FFFE
+	u8 value;
+	u8 pad[3];
+};
+
+struct torii_cheats {
+	char magic[8];
+	u32 version;
+	u16 count;
+	u16 max;
+	struct torii_cheat e[64];
+};
+
+const volatile struct torii_cheats torii_cheats __attribute__((used, aligned(4), section(".rodata.torii_cheats"))) = {
+	{'T', 'O', 'R', 'I', 'I', 'C', 'H', 'T'}, 1, 0, 64, {{0, 0, 0, 0, {0, 0, 0}}}};
+
+// Once a GB frame, as the vertical blank starts (lcd.s's newframe_vblank, which
+// has saved every register): a real GameShark writes in its VBlank interrupt
+void torii_cheats_run(void)
+{
+	u32 n = torii_cheats.count;
+	if (n > 64)
+		n = 64;
+	for (u32 i = 0; i < n; i++) {
+		u32 addr = torii_cheats.e[i].addr;
+		u32 bank = torii_cheats.e[i].bank;
+		u8 value = torii_cheats.e[i].value;
+		if (torii_cheats.e[i].kind != 1)
+			continue;
+		if (addr >= 0xE000 && addr < 0xFE00)
+			addr -= 0x2000;  // the echo of C000-DDFF
+		if (addr >= 0xC000 && addr < 0xE000) {
+			u8 *at;
+			if (addr >= 0xD000 && bank >= 2 && bank < 8)
+				at = GBC_EXRAM + (bank - 2) * 0x1000 + (addr - 0xD000);
+			else if (addr >= 0xD000 && bank == 1)
+				at = XGB_RAM + 0x1000 + (addr - 0xD000);
+			else
+				at = g_memmap_tbl[addr >> 12] + addr;  // whichever bank is mapped
+			*at = value;
+		} else if (addr >= 0xFF80 && addr < 0xFFFF) {
+			XGB_HRAM[addr - 0xFF80] = value;
+		}
+	}
+}
