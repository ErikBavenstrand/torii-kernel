+	ldrb_ r1,windowY
+	cmp r0,r1
+	blt entermode0
+	
+	ldrb_ r1,windowX
+	cmp r1,#166
+	bgt entermode0
+	cmp r1,#7
+	ble entermode1
+
+	@r1=bigbuffer
+	@r2=bg01cnt
+	@r3=bg23cnt
