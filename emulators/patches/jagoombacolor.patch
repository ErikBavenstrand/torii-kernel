@@ -119,6 +120,26 @@ sram_W:	@sram write ($A000-$BFFF)
 	strb r0,[r1,addy]
 	mov pc,lr
 @----------------------------------------------------------------------------
+sram_W_torii:	@Torii: sram write ($A000-$BFFF) of a 32K SRAM game. With its
+	@copy in the cart's SRAM (torii_raw32, sram.c) the write goes there too,
+	@as a real cart's would; without, it's marked for torii_autosave (ui.c)
+@----------------------------------------------------------------------------
+	ldr_ r1,memmap_tbl+40
+	add r1,r1,addy
+	strb r0,[r1]
+	ldr r2,=torii_raw32
+	ldrb r2,[r2]
+	cmp r2,#0
+	addne r1,r1,#0x0C000000	@XGB_SRAM 02038000.. -> 0E008000..
+	subne r1,r1,#0x00030000
+	strneb r0,[r1]
+	ldreq r1,=torii_sram_written
+	streq r1,[r1]		@nonzero: written this frame
+	mov pc,lr
+ .if XGB_SRAM - 0x02038000
+	.error "sram_W_torii maps XGB_SRAM at 02038000 to 0E008000"
+ .endif
+@----------------------------------------------------------------------------
 wram_W:	@wram write ($C000-$CFFF)
 @----------------------------------------------------------------------------
 @	ldr r1,memmap_tbl+48
