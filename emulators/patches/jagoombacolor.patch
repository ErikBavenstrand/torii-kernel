+//returns options for selected rom
+int drawmenu(int sel)
+{
+	int i,j,topline,toprow,romflags=0;
+	int top_displayed_line=0;
+	u8 *p;
+//	romheader *ri;
+
+	if(roms>20) {
+		topline=8*(roms-20)*sel/(roms-1);
+		toprow=topline/8;
+		j=(toprow<roms-20)?21:20;
+
+		ui_y=topline%8;
+	} else {
+		int ui_row;
+		
+		ui_row = (160-roms*8)/2;
+		ui_row/=4;
+		if (ui_row&1)
+		{
+			ui_y=4;
+			ui_row++;
+		}
+		ui_row/=2;
+		top_displayed_line=ui_row;
+
+		toprow=0;
+		j=roms;
+	}
+
