+int FindStateByIndex(int index, int type, stateheader **stateptr)
+{
+	getsram();
+	stateheader *sh = (stateheader*)(sram_copy+4);
+	int size = sh->size;
+	int i = 0;
+	int total = 0;
+	int foundstate = 0;
+	while (size != 0)
+	{
+		if (sh->type == type)
+		{
+			if (index == i)
+			{
+				*stateptr = sh;
+				foundstate = 1;
+			}
+			i++;
+		}
+		total += size;
+		sh = (stateheader*)(((u8*)sh) + size);
+		size = sh->size;
+	}
+	totalstatesize = total;
+	return foundstate;
+}
