diff --git a/Makefile b/Makefile
index 57e47d1..8792dac 100644
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,4 @@
-MAKEFILE	:=	makefile
+MAKEFILE	:=	Makefile
 
 #---------------------------------------------------------------------------------
 # Clear the implicit built in rules
@@ -102,9 +102,9 @@ export DEPSDIR	:=	$(CURDIR)/$(BUILD)
 #---------------------------------------------------------------------------------
 # automatically build a list of object files for our project
 #---------------------------------------------------------------------------------
-CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
-CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
-SFILES		:=	all.s
+CFILES		:=	$(sort $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c))))
+CPPFILES	:=	$(sort $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp))))
+SFILES		:=	$(sort all.s)
 DATA1		:=	font.lz77
 DATA2		:=	fontpal.bin
 DATA3		:=	#../goomba_mb.gba
@@ -123,7 +123,7 @@ else
 endif
 #---------------------------------------------------------------------------------
 
-export OFILES	:= $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o) $(DATA1:.lz77=.o) $(DATA2:.bin=.o) $(DATA3:.gba=.o)
+export OFILES	:= $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o) $(addsuffix .o,$(DATA1) $(DATA2))
 
 #---------------------------------------------------------------------------------
 # build a list of include paths
@@ -159,11 +159,11 @@ else
 
 DEPENDS	:=	$(OFILES:.o=.d)
 
-%.o	:	%.lz77
+%.lz77.o	:	%.lz77
 	@echo $(notdir $<)
 	@$(bin2o)
 
-%.o	:	%.bin
+%.bin.o	:	%.bin
 	@echo $(notdir $<)
 	@$(bin2o)
 
