+@@----------------------------------------------------------------------------
+@move_ui
+@@----------------------------------------------------------------------------
+@	stmfd sp!,{r0-addy,lr}
+@	ldr r0,=ui_x
+@	ldr r0,[r0]
+@	ldr r3,=ui_y_real
+@	ldr r3,[r3]
+@	orr r0,r0,r3,lsl#16
+@	ldr r3,=BG0CNTBUFF+6
+@	ldr r4,=DISPCNTBUFF
+@	mov r1,#160
+@	ldr r2,=dmascrollbuff
+@	ldr r2,[r2]
+@	add r2,r2,#12
+@@	ldr r7,=DMA0BUFF
+@@	add r7,r7,#12
+@	ldr r8,=scrollbuff
+@	ldr r8,[r8]
+@	add r8,r8,#12
+@@	ldr r7,=
+@@	ldr r2,=DMA0BUFF
+@@	ldr r6,=dmascrollbuff
+@@	str r2,[r6]
+@@	ldr r2,=DMA0BUFF+12
+@	ldr r6,=0x5A0C
+@move_ui_loop
+@	str r0,[r2],#16
+@@	str r0,[r7],#16
+@	str r0,[r8],#16
+@	ldrh r5,[r4]
+@	orr r5,r5,#0x0800
+@	strh r5,[r4],#2
+@	strh r6,[r3],#8
