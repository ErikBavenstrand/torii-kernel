+GFX_init_irq:
+	@install IRQ handler
+	ldr r1,=AGB_IRQVECT
+	ldr r2,=irqhandler
+	str r2,[r1]
+
+	mov r1,#REG_BASE
+	mov r0,#0x0008
+@	mov r0,#0x0028
+	strh r0,[r1,#REG_DISPSTAT]	@vblank en
+
+	add r2,r1,#REG_IE
+	mov r0,#-1
+	strh r0,[r2,#2]		@stop pending interrupts
+@	ldr r0,=0x1081
+@	strh r0,[r2]		;key,vblank,serial interrupt enable
+	ldr r0,=0x1085
+	strh r0,[r2]		@key,vcount,vblank,serial interrupt enable
+	mov r0,#1
+	strh r0,[r2,#8]		@master irq enable
+
+	bx lr
