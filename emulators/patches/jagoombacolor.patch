+	if (erase || newdata == NULL)
+	{
+		newSize = 0;
+	}
+	else
+	{
+		newSize = newdata->size;
+	}
+	
+	u8 *saveEnd = sram_copy + 4 + totalstatesize;
+	u8 *dest;
+	
+	if (stateFound)
+	{
+		dest = (u8*)foundState;
+		oldSize = foundState->size;
+	}
+	else
+	{
+		dest = saveEnd;
+	}
+	
+	u8 *newSaveEnd = saveEnd + newSize - oldSize;
+	
+	//out of memory?
+	if (newSaveEnd - sram_copy + 8 > save_start)
+	{
+		return 0;
+	}
