+//more dumb stuff so we don't waste space by using sprintf
+int twodigits(int n,char *s) {
+	int mod=n%10;
+	n=n/10;
+	*(s++)=(n+'0');
+	*s=(mod+'0');
+	return n;
+}
+
+char *number_at(char *dest, unsigned int n)
+{
+	unsigned int n2=n;
+	int digits=0;
+	char *retval;
+	do
+	{
+		n2/=10;
+		digits++;
+	} while (n2);
+	dest+=digits;
+	retval=dest;
+	*(dest--)='\0';
+	do
+	{
+		*(dest--)=(n%10)+'0';
+		n/=10;
+	} while (n);
+	return retval;
+}
+
+void number_cat(char *str, unsigned int n)
+{
+	number_at(str + strlen(str), n);
+}
