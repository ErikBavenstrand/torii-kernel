diff --git a/src/ui.c b/src/ui.c
index dbe9b9c..640a991 100644
--- a/src/ui.c
+++ b/src/ui.c
@@ -1,7 +1,7 @@
 #include "includes.h"
 
 EWRAM_BSS u8 autoA,autoB;				//0=off, 1=on, 2=R
-EWRAM_BSS u8 stime=0;
+u8 stime=3;	//Torii: autosleep off by default
 EWRAM_BSS u8 autostate=0;
 EWRAM_BSS int main_ui_selection;
 //EWRAM_BSS int selected;//selected menuitem.  used by all menus.
@@ -146,6 +146,47 @@ u32 getmenuinput(int menuitems)
 }
 */
 
+// Torii: a game with 32K of SRAM keeps it in EWRAM, which only the menu's
+// backup_gb_sram copies to the cart (8K games write through, sram_W2). A
+// second after the game's last write, as after an in-game save, this does
+// the same, so a power-off after saving keeps the save without the menu. It
+// takes 0.12 s or more (2026-10-25, the emulated cart), so RAM a game wrote
+// the same bytes to again isn't saved again.
+u32 torii_sram_written;	//set by sram_W_torii (memory.s)
+u32 torii_saved_sum;	//torii_sram_sum of the RAM as last loaded or saved
+u32 torii_sram_sum(void)
+{
+	const u32 *p=(const u32*)XGB_SRAM;
+	u32 h=0;
+	int i;
+	for (i=0;i<0x8000/4;i++)
+		h=h*31+p[i];
+	return h;
+}
+void torii_autosave(void)
+{
+	static u32 quiet,last;
+	if (torii_sram_written)
+	{
+		//a second's quiet; five within 30 s of the last save, for games
+		//that write as you play (Pokemon Picross wrote 26 times a minute)
+		torii_sram_written=0;
+		quiet=(last && frametotal-last<30*60)?5*60:60;
+		return;
+	}
+	if (quiet && --quiet==0)
+	{
+#if CARTSRAM
+		u32 sum=torii_sram_sum();
+		if (sum==torii_saved_sum)
+			return;
+		torii_saved_sum=sum;
+		last=frametotal|1;
+		backup_gb_sram(1);
+#endif
+	}
+}
