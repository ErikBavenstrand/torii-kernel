+	//Start up interrupt system
+	GFX_init();
+	vblankfptr=&vblankinterrupt;
+	
+
+
+//	vcountfptr=&vcountinterrupt;
+#if CARTSRAM
+	lzo_init();	//init compression lib for savestates
+#endif
+
+	//make 16 solid tiles
+	{
+		u32*  p=(u32*)COLOR_ZERO_TILES;
+		for (i=0;i<16;i++)
+		{
+			u32 val=(u32)i*(u32)0x11111111;
+			for (j=0;j<8;j++)
+			{
+				*p=val;
+				p++;
+			}
+		}
+	}
+
+
+	//load font+palette
+	loadfont();
+	loadfontpal();
+#if CARTSRAM
+	readconfig();
+#endif
+
+	jump_to_rommenu();
+}
