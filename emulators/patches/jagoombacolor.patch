@@ -3323,6 +3395,210 @@ after_wait:
 @	;sgb display is masked off...
 @	ldrb r0,novblankwait_
 @	cmp r0,#1
+
+@----------------------------------------------------------------------------
+@Torii: hi-colour GBC (jagoombacolor#20, #53). Games that rewrite the BG
+@palettes during the frame get each line's colours: hc_frame_start keeps
+@the palettes as they stand at line 0, hc_record (FF69_W) lists each
+@colour written during the visible lines with the line it first shows on,
+@hc_swap hands the list over with the scroll buffers, and at the GBA's
+@VBlank hc_vblank puts the line 0 palettes up and turns on the HBlank
+@interrupt (hc_hblank) that replays the list. A frame without a mid-frame
+@write costs a compare at VBlank. The buffers: equates.h, HC_*.
+@----------------------------------------------------------------------------
+	.global hc_frame_start
+	.global hc_record
+	.global hc_init
+	.global hc_vblank
+hc_init:	@at reset: empty lists, the gamma table to be made
+	stmfd sp!,{r0-r3,lr}
+	ldr r3,=HC_VARS
+	mvn r0,#0
+	strb r0,[r3,#HC_GAMMA_FOR]
+	ldr r1,=HC_BUF1
+	bl hc_init_buf
+	str r1,[r3,#HC_REC]
+	str r2,[r3,#HC_REC_PTR]
+	str r2,[r3,#HC_REC_END]
+	ldr r1,=HC_BUF2
+	bl hc_init_buf
+	str r1,[r3,#HC_SHOWN]
+	ldr r1,=HC_BUF3
+	bl hc_init_buf
+	str r1,[r3,#HC_SPARE]
+	mov r0,#0
+	str r0,[r3,#HC_READY]
+	str r0,[r3,#HC_MAX]
+	str r0,[r3,#HC_FULL]
+	ldr r1,=hc_active
+	str r0,[r1]
+	ldmfd sp!,{r0-r3,pc}
+hc_init_buf:	@r1=buffer, r0=-1: an empty list; r2=its first entry
+	add r2,r1,#68
+	str r0,[r2],#4			@guard
+	str r0,[r2]			@end mark
+	str r2,[r1]			@its end: the first entry
+	add r1,r2,#HC_ENTRIES*4
+	str r0,[r1]			@the end mark of a full list
+	sub r1,r2,#72
+	bx lr
+
+hc_frame_start:	@line 0 (timeout.s), GB registers saved: r0-r9,r11,r12 free
+	stmfd sp!,{lr}
+	ldr r12,=HC_VARS
+	ldrb_ r0,_gammavalue
+	ldrb r1,[r12,#HC_GAMMA_FOR]
+	cmp r0,r1
+	blne hc_make_gamma
+	ldr r0,[r12,#HC_REC]
+	add r0,r0,#4
+	ldr r1,=gbc_palette
+	ldmia r1!,{r2-r9}
+	stmia r0!,{r2-r9}
+	ldmia r1!,{r2-r9}
+	stmia r0!,{r2-r9}
+	add r0,r0,#4			@past the guard
+	str r0,[r12,#HC_REC_PTR]
+	add r0,r0,#HC_ENTRIES*4
+	str r0,[r12,#HC_REC_END]
+	ldmfd sp!,{pc}
+
+hc_make_gamma:	@HC_GAMMA[i] = gamma_convert_one(grey i); r12=HC_VARS kept
+	stmfd sp!,{r12,lr}
+	strb r0,[r12,#HC_GAMMA_FOR]
+	ldr r4,=HC_GAMMA
+	mov r8,#0
+0:
+	add r9,r8,r8,lsl#5
+	add r9,r9,r8,lsl#10
+	str r9,[sp,#-4]!
+	mov r5,sp
+	ldrb_ r1,_gammavalue
+	bl_long gamma_convert_one
+	add sp,sp,#4
+	add r8,r8,#1
+	cmp r8,#32
+	bne 0b
+	ldmfd sp!,{r12,pc}
+
+hc_gamma:	@r0=colour, gamma-converted through HC_GAMMA; r1-r3 changed
+	ldr r2,=HC_GAMMA
+	and r3,r0,#0x1F
+	add r3,r3,r3
+	ldrh r1,[r2,r3]
+	and r1,r1,#0x1F
+	and r3,r0,#0x3E0
+	mov r3,r3,lsr#4
+	ldrh r3,[r2,r3]
+	and r3,r3,#0x3E0
+	orr r1,r1,r3
+	and r3,r0,#0x7C00
+	mov r3,r3,lsr#9
+	ldrh r3,[r2,r3]
+	and r3,r3,#0x7C00
+	orr r0,r1,r3
+	bx lr
+
+
+hc_swap:	@bufferfinish, the GBA's VBlank IRQ off: this frame's list is next
+	@to show. Three buffers: one recording, one showing and one ready
+	@for the next VBlank or spare, so a frame that ends before the GBA's
+	@VBlank never records over the list on the screen. r0-r9,r11,r12 free
+	ldr r12,=HC_VARS
+	ldr r0,[r12,#HC_REC]
+	ldr r1,[r12,#HC_REC_PTR]
+	mvn r3,#0
+	str r3,[r1]			@end mark
+	str r1,[r0]			@the list's end
+	ldr r2,[r12,#HC_READY]		@a list not shown yet: dropped for this one
+	cmp r2,#0
+	bne 1f
+	ldr r2,[r12,#HC_SPARE]
+	mov r3,#0
+	str r3,[r12,#HC_SPARE]
+1:
+	str r0,[r12,#HC_READY]
+	str r2,[r12,#HC_REC]
+	add r2,r2,#72
+	str r2,[r12,#HC_REC_PTR]	@nothing recorded until line 0
+	str r2,[r12,#HC_REC_END]
+	@statistics: the most entries in a frame, frames that filled the list
+	add r0,r0,#72
+	sub r0,r1,r0
+	mov r0,r0,lsr#2
+	ldr r1,[r12,#HC_MAX]
+	cmp r0,r1
+	strhi r0,[r12,#HC_MAX]
+	cmp r0,#HC_ENTRIES
+	ldrhs r1,[r12,#HC_FULL]
+	addhs r1,r1,#1
+	strhs r1,[r12,#HC_FULL]
+	bx lr
+
+hc_vblank:	@display_frame: r0-r9,r11,r12 free
+	ldr r12,=HC_VARS
+	ldr r0,[r12,#HC_READY]		@a new frame's list: on the screen now
+	cmp r0,#0
+	ldrne r1,[r12,#HC_SHOWN]
+	strne r0,[r12,#HC_SHOWN]
+	strne r1,[r12,#HC_SPARE]
+	movne r1,#0
+	strne r1,[r12,#HC_READY]
+	ldreq r0,[r12,#HC_SHOWN]
+	ldr r1,[r0],#4			@its end; r0=its line 0 palettes
+	add r2,r0,#68
+	cmp r1,r2
+	beq hc_off			@no mid-frame writes
+	ldrb_ r3,gbcmode
+	cmp r3,#0
+	beq hc_off
+	ldrb_ r3,sgb_mask
+	cmp r3,#0
+	bne hc_off
+	ldrb_ r3,lcdctrl0frame
+	tst r3,#0x80			@screen off: transfer_palette_'s white
+	beq hc_off
+	stmfd sp!,{lr}
+	ldr r3,=hc_cursor
+	str r2,[r3]
+	@the line 0 palettes, as transfer_palette_ puts them
+	ldr r4,=PALETTE_BASE+0x100
+	ldr r5,=PALETTE_BASE+0xF0
+	mov r6,r0
+	mov r7,#8
+	ldrb_ r8,_gammavalue
+0:
+	ldmia r6!,{r9,r11}
+	cmp r8,#0
+	beq 1f
+	mov r0,r9
+	bl hc_gamma
+	mov r12,r0
+	mov r0,r9,lsr#16
+	bl hc_gamma
+	orr r9,r12,r0,lsl#16
+	mov r0,r11
+	bl hc_gamma
+	mov r12,r0
+	mov r0,r11,lsr#16
+	bl hc_gamma
+	orr r11,r12,r0,lsl#16
+1:
+	stmia r4,{r9,r11}
+	strh r9,[r5],#2
+	add r4,r4,#32
+	subs r7,r7,#1
+	bne 0b
+	mov r0,#0x10
+	ldr r1,=hc_active
+	str r0,[r1]
+	ldmfd sp!,{pc}
+hc_off:
+	mov r0,#0
+	ldr r1,=hc_active
+	str r0,[r1]
+	bx lr
+	.ltorg
 	.popsection
 
 	.pushsection .text
@@ -4691,8 +4967,6 @@ vram_W2:
 FF69_W:	@BCPD - BG Color Palette Data
 	ldrb_ r1,BCPS_index
 	and r2,r1,#0x3F
-	ldr addy,=gbc_palette
-	strb r0,[addy,r2]
 	tst r1,#0x80
 	addne r1,r1,#1
     @Minucce's tweaks
@@ -4700,7 +4974,45 @@ FF69_W:	@BCPD - BG Color Palette Data
     orrne r1, r1, #0x80
     
 	strneb_ r1,BCPS_index
-	bx lr
+	@Torii: a byte that changes is also recorded for the line (hi-colour)
+	ldr addy,=gbc_palette
+	ldrb r1,[addy,r2]
+	cmp r1,r0
+	bxeq lr
+	strb r0,[addy,r2]
+hc_record:	@Torii: FF69_W's changed byte (r2=its index, addy=gbc_palette), for hi-colour (hc_* in .vram1)
+	@the line it first shows on: this one, or in HBlank the next
+	ldrb_ r1,scanline
+	ldr_ r0,scanline_oam_position
+	cmp cycles,r0
+	addmi r1,r1,#1
+	cmp r1,#144
+	bxhs lr				@the next frame's: in its line 0 palettes
+	stmfd sp!,{r3,r4,lr}
+	bic r2,r2,#1
+	ldrh r0,[addy,r2]		@the colour
+	and r3,r2,#0x38			@palette*8
+	and r2,r2,#0x06			@colour*2
+	orr r2,r2,r3,lsl#2		@its offset from 0x05000100
+	orr r4,r2,r1,lsl#8
+	ldrb_ r1,_gammavalue
+	movs r1,r1
+	beq 0f
+	bl_long hc_gamma
+0:
+	orr r0,r0,r4,lsl#16
+	ldr addy,=HC_VARS
+	ldr r2,[addy,#HC_REC_PTR]
+	ldr r1,[r2,#-4]			@the colour's other byte, same line: one entry
+	eor r1,r1,r0
+	movs r1,r1,lsr#16
+	streq r0,[r2,#-4]
+	ldmeqfd sp!,{r3,r4,pc}
+	ldr r1,[addy,#HC_REC_END]
+	cmp r2,r1
