diff --git a/src/lcd.s b/src/lcd.s
index 634594d..1a1e587 100644
--- a/src/lcd.s
+++ b/src/lcd.s
@@ -331,6 +331,11 @@ GFX_reset:	@called with CPU reset
 	movs r0,r0
 	bne 1f
 	
+	@Torii: a palette the game's config holds is kept
+	ldr r0,=palette_saved
+	ldrb r0,[r0]
+	movs r0,r0
+	bne 1f
 	@get GBC palette
 	ldr_ r0,memmap_tbl
 	blx_long GetGbcPaletteNumber
