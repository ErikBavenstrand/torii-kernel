+//returns a rom number, or -1
+int find_rom_number_by_checksum(u32 sum)
+{
+	int i;
+	for (i=0;i<roms;i++)
+	{
+		if(sum==checksum_romnum(i))
+			return i;
+	}
+	return -1;
+}
