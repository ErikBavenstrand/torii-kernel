+void jump_to_rommenu(void)
+{
+#if GCC
+	extern u8 __sp_usr[];
+	u32 newstack=(u32)(&__sp_usr);
+	__asm__ volatile ("mov sp,%0": :"r"(newstack));
+#else
+	__asm {mov r0,#0x3007f00}		//stack reset
+	__asm {mov sp,r0}
+#endif
+	rommenu();
+	novblankwait=torii_vblank;	//Torii: the saved VSync setting (jagoombacolor#36)
+	run(1);
+	while (true);
