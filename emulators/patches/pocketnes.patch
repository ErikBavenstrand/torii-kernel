diff --git a/src/loadcart.c b/src/loadcart.c
index 5e635eb..6133b77 100644
--- a/src/loadcart.c
+++ b/src/loadcart.c
@@ -268,13 +268,39 @@ void loadcart(int rom_number, int emu_flags, int loading_state)
 	return;
 }
 
+//Torii: a game's region (PocketNES#3): the one picked in the menu, which the
+//config keeps (torii_region), else the NES 2.0 header's (byte 12: NTSC, PAL,
+//either, Dendy), else the flags the caller passes
+APPEND static int torii_game_region(int rom_number, int emu_flags)
+{
+	static const u8 from_header[4]={0,1,0,2};
+	static const u8 flags[4]={REGION_NTSC,REGION_PAL,REGION_DENDY,REGION_OVERCLOCKED};
+	int region;
+	if (torii_region>=1 && torii_region<=4)
+	{
+		region=torii_region-1;
+	}
+	else
+	{
+		const u8 *header=findrom(rom_number)+48;
+		if ((header[7]&0x0C)!=0x08)
+			return emu_flags;
+		region=from_header[header[12]&3];
+	}
+	return (emu_flags&~0x1C)|flags[region];
+}
+
 APPEND void loadcart2(int rom_number, int emu_flags, int loading_state)
-{	
+{
 	//loading_state: 0 if called from loadstate, 1 if called from rom menu
 //	u8 *p;
 	u8 *romname_p;
 	u8 *nesheader;
-	
+
+	if (loading_state==1)
+	{
+		emu_flags=torii_game_region(rom_number,emu_flags);	//Torii
+	}
 	if (emu_flags & EMUFLAGS_PALTIMING)
 	{
 		emu_flags |= EMUFLAGS_FPS50;
