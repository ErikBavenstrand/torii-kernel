# The launch's progress dialog (source/ui/dialog.h): CLEAN BOOT of Hello.gba
# from its menu, while the kernel checks its save and loads it.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:A -k @12:-
-w "screen ready: progress"
-s @1:screen.png
