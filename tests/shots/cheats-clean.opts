# Leaving the cheat screen (source/screens/cheats.c) with a new pick while
# Settings boots GBA games clean, in the light theme: Infinite lives picked,
# then B: a dialog says the picks run only with addons, and where to set it.
#! settings 28=1 35=1
# The tests' hook: lists open on their first row (else a list opens on
# Hello, the game Recent played last)
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-k @8:A -k @12:-
-k @32:B -k @36:-
-w "and the game boots clean"
-w "screen ready: dialog"
-s @8:clean.png
