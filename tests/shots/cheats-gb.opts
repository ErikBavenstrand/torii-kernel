# A GB game's cheat screen (source/screens/cheats.c)
# over tests/shots/data/cheat-gb.cht: the game popup has a Cheats row (popup);
# the Game Genie codes list, one picked, the GameShark one greyed (RAM codes
# don't run yet) and a wildcard one unreadable, with no + Add code row (screen);
# the greyed one's reason in the hint bar (greyed); SELECT: a Game Genie code's page,
# with no format and budget rows (details); START's menu has no Edit code, Buttons or Add code (menu).
#! settings 28=1
#! sd-file /Cheat.gb 0 tests/shots/data/cheat.gb
#! sd-file /torii/cheats/Cheat.cht 0 tests/shots/data/cheat-gb.cht
# The tests' hook: lists open on their first row
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @16:RIGHT -k @20:- -k @28:A -k @32:-
-w "nav: page gb ready"
-k @16:START -k @20:-
-w "screen ready: game-popup"
-s @8:popup.png
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-s @8:screen.png
-k @16:DOWN -k @20:- -k @28:DOWN -k @32:- -k @40:DOWN -k @44:-
-s @60:greyed.png
-k @68:SELECT -k @72:-
-w "screen ready: cheat-guide"
-s @8:details.png
-k @16:B -k @20:-
-w "screen ready: cheats"
-k @8:START -k @12:-
-w "screen ready: cheat-menu"
-s @24:menu.png
# B closes it; DOWN twice onto a code for a byte the emulator sums (sampled): its note in the hint bar
-k @40:B -k @44:- -k @52:DOWN -k @56:- -k @64:DOWN -k @68:-
-s @84:sampled.png
