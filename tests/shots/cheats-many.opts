# Many cheats (Games/Many cheats.gba: 40 cheats of one to three options).
# The first page; down past a section, A picks an option, RIGHT pages twice,
# A picks another (paged); DOWN leaves it showing picked (picked); A there
# moves the pick and UP goes back (moved); LEFT pages back (back); B leaves (menu)
#! settings 4=1
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @20:A -k @24:-
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @28:A -k @32:-
-w "screen ready: file-menu"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:- -k @40:DOWN -k @44:-
-k @52:A -k @56:-
-w "screen ready: cheats"
-s @1:screen.png
-k @10:DOWN -k @14:- -k @22:A -k @26:- -k @34:RIGHT -k @38:- -k @60:RIGHT -k @64:- -k @86:A -k @90:-
-s @120:paged.png
-k @130:DOWN -k @134:-
-s @150:picked.png
-k @160:A -k @164:- -k @172:UP -k @176:-
-s @200:moved.png
-k @210:LEFT -k @214:-
-s @250:back.png
# Releasing B leaves: the game menu shows CHEAT(2) for the two cheats picked
-k @260:B -k @264:-
-w "screen ready: file-menu"
-s @1:menu.png
