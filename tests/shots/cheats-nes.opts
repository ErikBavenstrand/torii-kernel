# A NES game's cheat screen over tests/shots/data/cheat-nes.cht: a Game Genie
# code, a picked raw RAM write (every frame), a two-line one and one to the ROM
# (unreadable); SELECT on the picked one shows it runs every frame (details).
#! settings 28=1
#! sd-file /Cheat.nes 0 tests/shots/data/cheat.nes
#! sd-file /torii/cheats/Cheat.cht 0 tests/shots/data/cheat-nes.cht
# The tests' hook: lists open on their first row
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @16:RIGHT -k @20:- -k @28:A -k @32:-
-w "nav: page nes ready"
-k @16:START -k @20:-
-w "screen ready: game-popup"
-s @8:popup.png
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-s @8:screen.png
-k @16:DOWN -k @20:-
-s @40:picked.png
-k @48:SELECT -k @52:-
-w "screen ready: cheat-guide"
-s @8:details.png
-k @16:B -k @20:-
-w "screen ready: cheats"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:-
-s @44:unreadable.png
