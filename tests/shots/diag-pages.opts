# Diagnostics' pages: the loader's CRC line fits (v0.3.2: it and the cart
# page's WAITCNT line ran off the edge; diag_say now wraps a long line), the
# clock page says it is measuring before its 2-second wait, and the EEPROM
# page speaks to users. DIAGNOSE is the last row of SETTINGS page 2, as in
# diag-start. (The cart page shows the build ID, which changes with the code.)
-w "screen ready: sd-list"
-k @8:R -k @12:-
-w "screen ready: nor-list"
-k @8:R -k @12:-
-w "screen ready: settings1"
-k @8:R -k @12:-
-w "screen ready: settings2"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:- -k @44:DOWN -k @48:-
-k @56:DOWN -k @60:- -k @68:DOWN -k @72:- -k @80:DOWN -k @84:- -k @92:DOWN -k @96:-
-k @104:DOWN -k @108:- -k @116:A -k @120:-
-w "screen ready: diag-start"
-k @8:A -k @12:-
-w "diag: measuring the clock"
-s @10:clock.png
-w "diag: boot loader present: pass"
-s @10:loader.png
-w "diag: B, each time"
-s @10:eeprom.png
