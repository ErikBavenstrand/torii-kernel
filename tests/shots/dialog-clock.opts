# The list's clock keeps going under a dialog (dialog_set_tick): with the
# clock running from the scenarios' epoch, L+START on Hello.gba asks before
# deleting it, and 2 s later the dimmed header shows the time 2 s on
# (v0.3.2: it stopped while a dialog was up, as in a 4-minute erase)
-c 1767270896
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:L -k @48:L+START -k @52:-
-w "screen ready: dialog"
-s @1:asked.png
-s @130:later.png
-k @140:B -k @144:-
