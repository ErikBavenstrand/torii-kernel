# A message closes with A as well as B (only B before v0.3.2; the hint says
# "[A]OK"). A quick double A on LOAD SAVE in the NOR game menu: the first
# picks it and "No save file found" opens; the second comes while it is
# still opening and does nothing (ui_frame), so the message is never closed
# unseen. A once it is up closes it.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:A -k @36:-
-w "nor: list saved"
-w "screen ready: nor-list"
-k @8:A -k @12:-
-w "screen ready: nor-menu"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-k @36:A -k @38:- -k @40:A -k @42:-
-w "screen ready: dialog"
-s @20:up.png
-k @28:A -k @32:-
-s @60:closed.png
