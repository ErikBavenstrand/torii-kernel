# The error dialog for a game in more pieces than the cart's table holds
# (en_error_7, the longest dialog text with en_file_overflow): CLEAN BOOT of
# a 1 MB game (Hello.gba padded) in 62 runs of clusters, which sorts first
# (as tests/fragmented.sh's refused case).
#! sd-fragmented /Frag.gba 0x100000 62 tests/roms/hello/hello.gba
#! expect-error error 7:
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:A -k @12:-
-w "screen ready: dialog"
-s @1:dialog.png
