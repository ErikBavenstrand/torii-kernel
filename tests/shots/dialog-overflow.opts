# The error dialog for a game too big to start from the SD card
# (en_file_overflow, the longest dialog text with en_error_7): CLEAN BOOT of
# a GBA game just over 32 MB (Hello.gba padded), which sorts first.
#! sd-file /Big.gba 0x2000004 tests/roms/hello/hello.gba
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:A -k @12:-
-w "screen ready: dialog"
-s @1:dialog.png
