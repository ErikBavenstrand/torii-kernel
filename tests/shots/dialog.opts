# A question dialog over the mode 3 menu (source/ui/dialog.h): L+START on
# Hello.gba asks to delete it. B says no, and the SD list comes back.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:L -k @52:L+START -k @56:-
-w "screen ready: dialog"
-s @1:screen.png
-k @8:B -k @12:-
-w "screen ready: sd-list"
-s @1:back.png
