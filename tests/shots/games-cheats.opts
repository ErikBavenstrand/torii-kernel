# The cheat screen (source/screens/cheats.c) from Hello's popup's Cheats
# (its count, 5, at the right: the rows the screen lists), in the light
# theme: Hello's cheats under the game's name, the master code hidden, Max
# money ticked (the file picks it), + Add code last; on Pick a level the hint bar says it
# needs editing and the row is greyed; A on Infinite lives ticks it; B saves
# and goes back to the list.
#! settings 28=1
# The tests' hook: lists open on their first row (else a list opens on
# Hello, the game Recent played last)
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-s @4:popup.png
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-s @4:screen.png
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:-
-s @48:greyed.png
-k @52:UP -k @56:- -k @64:UP -k @68:- -k @76:UP -k @80:-
-k @88:A -k @92:-
-s @108:picked.png
-k @116:B -k @120:-
-w "cheats: back"
-w "screen ready: games"
-s @8:back.png
