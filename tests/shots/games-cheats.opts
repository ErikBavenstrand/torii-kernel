# The cheat screen (source/showcht.c) from the game popup's Boot with addon,
# with Cheats on (slot 4), in the light theme: Hello's cheats under the
# game's name, in the game lists' look; A picks the first entry ("On" at
# its right), and B goes back to the list.
#! settings 28=1 4=1
-w "nav: home ready"
-k @8:DOWN -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @20:DOWN -k @24:- -k @28:DOWN -k @32:-
-k @40:A -k @44:-
-w "screen ready: cheats"
-s @4:screen.png
-k @8:A -k @12:-
-s @24:picked.png
-k @32:B -k @36:-
-w "cheats: back"
-s @40:back.png
