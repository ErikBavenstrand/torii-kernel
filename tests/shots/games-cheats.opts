# The cheat screen (source/showcht.c) from the game popup's Play « addons »
# (LEFT from « default » wraps to it),
# with Cheats on (slot 4), in the light theme: Hello's cheats under the
# game's name, in the game lists' look; A picks the first entry ("On" at
# its right), and B goes back to the list.
#! settings 28=1 4=1
# The tests' hook: lists open on their first row (else a list opens on
# Hello, the game Recent played last)
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:LEFT -k @16:-
-k @40:A -k @44:-
-w "screen ready: cheats"
-s @4:screen.png
-k @8:A -k @12:-
-s @24:picked.png
-k @32:B -k @36:-
-w "cheats: back"
-s @40:back.png
