# Favourites (source/screens/games.c, mockup #12) in the light theme: the
# game popup's Favourite toggles in place (its value turns "on" and the
# row gets its star), for two games in the GBA list; back home, Favourites
# shows, and its page lists them A-Z with their console marks.
#! settings 28=1
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:DOWN -k @12:-
-k @20:START -k @24:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:-
-k @24:A -k @28:-
-s @40:toggled.png
-k @48:B -k @52:-
-k @68:UP -k @72:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:-
-k @24:A -k @28:-
-k @40:B -k @44:-
-s @60:starred.png
-k @66:B -k @70:-
-w "nav: home ready"
-k @8:LEFT -k @12:-
-k @20:A -k @24:-
-w "nav: page fav ready"
-s @2:screen.png
