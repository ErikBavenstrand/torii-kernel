# A Game Boy page (source/screens/games.c, mockup #13) in the light theme:
# the GB games A-Z in the console's colour; their popup has no Clean boot
# or Boot with addon (GB games always start clean).
#! settings 28=1
#! sd-file "/Kirby's Dream Land.gb" 262144 tests/roms/hello/hello.gba
#! sd-file "/Dr. Mario.gb" 32768 tests/roms/hello/hello.gba
#! sd-file "/Tetris (World) (Rev 1).gb" 32768 tests/roms/hello/hello.gba
#! sd-file "/Tetris (Japan).gb" 32768 tests/roms/hello/hello.gba
-w "nav: home ready"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:-
-k @28:A -k @32:-
-w "nav: page gb ready"
-s @2:screen.png
-k @8:START -k @12:-
-w "screen ready: game-popup"
-s @12:popup.png
