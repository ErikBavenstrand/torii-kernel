# The GBA page (source/screens/games.c) in the dark theme: the card's GBA
# games A-Z with their sizes, the title's position and the hint bar (#6).
# DOWN moves the pill a row (hashed every frame of its slide); RIGHT jumps
# to the next letter with the letter card (#8); START opens the game popup
# beside the row (#9), whose Delete (its last item, after Rename and Game
# info) asks first (#10); Cancel goes back to
# the popup, and Game info shows the game's page, where RIGHT changes its
# save type, written as B goes back to the list. Games 002 and 004 have
# saves: the save mark beside their sizes.
#! sd-file "/torii/saves/Long/Game 002.gba/Main.sav" 0x2000 /dev/null
#! sd-file "/torii/saves/Long/Game 004.gba/Main.sav" 0x2000 /dev/null
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-s @2:screen.png
-k @8:DOWN -k @12:-
-H @8:@20
-s @24:down.png
-k @30:RIGHT -k @34:-
-s @38:letter.png
-k @80:START -k @84:-
-w "screen ready: game-popup"
-s @8:popup.png
-k @12:DOWN -k @16:- -k @20:DOWN -k @24:- -k @28:DOWN -k @32:- -k @36:DOWN -k @40:- -k @44:DOWN -k @48:- -k @52:DOWN -k @56:-
-k @64:A -k @68:-
-s @80:delete.png
-k @88:B -k @92:-
-s @108:cancelled.png
-k @112:UP -k @116:-
-k @124:A -k @128:-
-w "screen ready: game-info"
-s @20:info.png
-k @24:RIGHT -k @28:-
-s @36:info-sram.png
-k @44:B -k @48:-
-w "save type of"
-s @30:closed.png
