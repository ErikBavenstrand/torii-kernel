# The GBA page (source/screens/games.c, mockup #6) in the light theme; a
# held DOWN glides the list (every frame hashed, games-move's cycles).
# Games 002 and 004 have saves: the save mark beside their sizes.
#! settings 28=1
#! sd-file "/torii/saves/Long/Game 002.gba/Main.sav" 0x2000 /dev/null
#! sd-file "/torii/saves/Long/Game 004.gba/Main.sav" 0x2000 /dev/null
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-s @2:screen.png
-k @8:DOWN -k @70:-
-H @8:@90
-s @96:held.png
