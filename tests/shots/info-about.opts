# Info's About page, in the dark theme: Torii's version and build (pinned
# here), the cart's revision, FPGA firmware and NOR, the SD card's size and
# free space, what the card and the lists hold, Torii's folder and the
# credits; R pages down to the rest. Then In game, which fills in what
# Settings holds, and the first screen of Saves, Cheats and Questions.
-w "nav: home ready"
-P @2:info_version:0.4.0
-P @2:info_build:0000B17A
-k @8:LEFT -k @12:- -k @16:A -k @20:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:- -k @40:DOWN -k @44:- -k @66:A -k @70:-
-w "screen ready: info-about"
-s @1:about.png
-k @8:R -k @12:-
-s @30:about-2.png
-k @36:R -k @40:- -k @48:R -k @52:- -k @60:R -k @64:-
-s @90:about-end.png
-k @96:B -k @100:-
-w "screen ready: info"
-k @8:UP -k @12:- -k @16:UP -k @20:- -k @24:UP -k @28:- -k @32:UP -k @36:- -k @56:A -k @60:-
-w "screen ready: info-ingame"
-s @1:ingame.png
-k @8:B -k @12:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @30:A -k @34:-
-w "screen ready: info-saves"
-s @1:saves.png
-k @8:B -k @12:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @30:A -k @34:-
-w "screen ready: info-cheats"
-s @1:cheats.png
-k @8:B -k @12:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @30:A -k @34:-
-w "screen ready: info-help"
-s @1:help.png
