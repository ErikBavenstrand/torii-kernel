# Info's About page, in the dark theme: Torii's version and build (pinned
# here), the cart's revision and FPGA firmware, the SD card's size and free
# space, and the credits; R pages down to the rest. Then In game and Your
# cart, which fill in what Settings and the card hold.
-w "nav: home ready"
-P @2:info_version:0.4.0
-P @2:info_build:0000B17A
-k @8:LEFT -k @12:- -k @16:A -k @20:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @50:A -k @54:-
-w "screen ready: info-about"
-s @1:about.png
-k @8:R -k @12:-
-s @30:about-end.png
-k @36:B -k @40:-
-w "screen ready: info"
-k @8:UP -k @12:- -k @16:UP -k @20:- -k @40:A -k @44:-
-w "screen ready: info-ingame"
-s @1:ingame.png
-k @8:B -k @12:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @30:A -k @34:-
-w "screen ready: info-cart"
-s @1:cart.png
