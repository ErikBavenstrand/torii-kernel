# Info's About page on a FAT32 card whose free cluster count isn't recorded
# (FSInfo, as some PCs leave it): reading it would mean reading the whole
# FAT, so the page gives the card's size and type, and says its free space
# isn't recorded.
#! sd-fsinfo-unknown
-w "nav: home ready"
-P @2:info_version:0.4.0
-P @2:info_build:0000B17A
-k @8:LEFT -k @12:- -k @16:A -k @20:-
-w "screen ready: info"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @50:A -k @54:-
-w "info: no free cluster count on the card"
-w "screen ready: info-about"
-k @8:R -k @12:-
-s @30:about-end.png
