# The Info page (source/screens/info.c, mockup #21) in the light theme: UP
# on home goes round the end to Info, A opens it. Its rows on two cards
# (the four reading pages, then Diagnostics), each with its 8x8 icon and
# what it holds, and the position at the right. DOWN from About steps over
# the gap between the cards to Diagnostics (the pill's slide hashed every
# frame); UP comes back. Version and build ID are pinned so the screens
# don't change with each build.
#! settings 28=1
-w "nav: home ready"
-P @2:info_version:0.4.0
-P @2:info_build:0000B17A
-k @8:UP -k @12:- -k @16:A -k @20:-
-w "screen ready: info"
-s @1:rows.png
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-s @50:about.png
-k @56:DOWN -k @60:-
-H @56:@76
-s @80:diag.png
-k @88:UP -k @92:-
-s @112:back-up.png
