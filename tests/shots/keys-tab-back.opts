# R, DOWN, DOWN and L all pressed while the SD list goes out (cursor on
# Games): the NOR list gets R's screen, a DOWN and L, and goes back. The
# second DOWN, held for the frame after, was the NOR list's too: it is
# dropped, and the SD list comes back on Games (it moved to Long in review).
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:R -k @17:- -k @18:DOWN -k @19:- -k @20:DOWN -k @21:- -k @22:L -k @23:-
-s @100:end.png
# The tear watch: no write changes the screen while it scans out
-T 1:99999
