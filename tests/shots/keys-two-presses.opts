# Two presses of DOWN while the SD list goes out into the folder Long: the
# folder's list comes in with the cursor two rows down, on Game 001.gba (one
# row before v0.3.2, as the waiting keys were a bitmask).
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:-
-k @28:A -k @29:DOWN -k @30:- -k @31:DOWN -k @32:-
-w "screen ready: sd-list"
-s @1:screen.png
