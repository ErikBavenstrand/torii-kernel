# sd-root.opts in Korean: lang/ko.ini's pack set in Settings (slot 0, its id
# 0xBB63), so every string the scenario shows is Korean, at its width. The SD
# card page (source/screens/sdcard.c) at the card's root with games named in
# Hangul: the file list, the file popup and File info.
#! settings 0=47971
#! settings 28=1
#! sd-file /torii/lang/ko.lng 0 dist/lang/ko.lng
#! sd-put "/한글 게임 1.gba" tests/roms/hello/hello.gba
#! sd-put "/가나다라마바사.gba" tests/roms/hello/hello.gba
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:LEFT -k @28:- -k @32:LEFT -k @36:- -k @40:A -k @44:-
-w "sdcard: counted /"
-s @2:root.png
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:- -k @44:START -k @48:-
-w "sdcard: popup"
-s @12:popup.png
-k @20:UP -k @24:- -k @44:A -k @48:-
-s @64:confirm.png
-k @72:B -k @76:-
-k @96:UP -k @100:- -k @108:A -k @112:-
-s @140:file-info.png
