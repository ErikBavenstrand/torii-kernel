# The list's view can't be pushed (the test hook ui_push_fail_test, poked by
# name, fails one push): R from the SD list goes out, the error comes in
# from black instead of a black screen that takes no key (before v0.3.2),
# and once it closes the session starts over and the NOR list comes in.
#! expect-error engine: ui: view nor-list: failed for a test
#! expect-error lists: ui: view nor-list: failed for a test
-w "screen ready: sd-list"
-p @8:ui_push_fail_test:1
-k @10:R -k @14:-
-w "screen ready: dialog"
-s @1:error.png
-k @8:B -k @12:-
-w "screen ready: nor-list"
-s @1:list.png
