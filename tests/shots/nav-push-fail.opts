# A page's view can't be pushed (the test hook ui_push_fail_test, poked by
# name, fails one push): A on home goes out, the error comes in from black
# instead of a black screen that takes no key (before v0.3.2), and once it
# closes the session starts over and the page comes in.
#! expect-error engine: ui: view games: failed for a test
#! expect-error nav: ui: view games: failed for a test
-w "nav: home ready"
-p @8:ui_push_fail_test:1
-k @10:A -k @14:-
-w "screen ready: dialog"
-s @1:error.png
-k @8:B -k @12:-
-w "nav: page recent ready"
-s @1:page.png
