# NOR DELETE asks first, as the SD list's delete and FORMAT ALL do (it erased
# at once before v0.3.2): WRITE TO NOR CLEAN puts Hello.gba on the game NOR,
# listed with its size in K; DELETE in its NOR game menu asks over its name;
# B keeps it, and A on the question erases it, leaving "No games in NOR"
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:A -k @36:-
-w "nor: list saved"
-w "screen ready: nor-list"
-s @1:list.png
-k @8:A -k @12:-
-w "screen ready: nor-menu"
-k @8:DOWN -k @12:- -k @20:A -k @24:-
-w "screen ready: dialog"
-s @1:ask.png
-k @8:B -k @12:-
-s @40:kept.png
-k @48:A -k @52:-
-w "screen ready: nor-menu"
-k @8:DOWN -k @12:- -k @20:A -k @24:-
-w "screen ready: dialog"
-k @8:A -k @12:-
-w "nor: list saved"
-w "screen ready: nor-list"
-s @1:empty.png
