# WRITE TO NOR CLEAN of a 4 MB game (Hello.gba padded): the progress bar
# halfway, with the step's percentage, and full with "Done" before the
# dialog closes (source/progress.h)
#! sd-file /Big.gba 0x400000 tests/roms/hello/hello.gba
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:A -k @36:-
-w "screen ready: progress"
-s @760:half.png
-w "nor: list saved"
-s @6:done.png
