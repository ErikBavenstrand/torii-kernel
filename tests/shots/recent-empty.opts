#! sd-file "/SAVER/Recently play.txt" 0 /dev/null
# Recently Played with no game played: its label, on the header's plane over
# the list's, fades in with the screen in the alpha fade (GBA alpha blends a
# pixel only with the layer just under it: the empty list leaves its plane
# clear there, so the label blends with the backdrop as the rest does);
# frame 3 is halfway
-w "screen ready: sd-list"
-k @8:START -k @12:-
-w "ui: pushed recent"
-s @3:fading.png
-H @1:@14
-w "screen ready: recent"
-s @1:screen.png
