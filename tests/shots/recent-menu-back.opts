# B on a Recently Played game's menu goes back to Recently Played, its
# cursor on the game (the second, /Games/Idle.gba), not to the SD list. The
# menu closes over the list, which logs no new "screen ready": the shot is
# well after the close.
-w "screen ready: sd-list"
-k @8:START -k @12:-
-w "screen ready: recent"
-k @8:DOWN -k @12:- -k @20:A -k @24:-
-w "screen ready: file-menu"
-s @1:menu.png
-k @8:B -k @12:-
-s @60:screen.png
