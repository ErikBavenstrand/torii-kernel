# The global save manager in the light theme with nothing to report: the
# card's saves belong to games that are there, so no orphan is listed, and the
# trash is empty (Empty trash now is dimmed).
#! settings 28=1
#! sd-file "/torii/saves/Games/Idle.gba/Main.sav" 0x2000 /dev/null
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:A -k @28:-
-w "screen ready: settings"
-k @8:R -k @12:- -k @20:R -k @24:- -k @32:R -k @36:- -k @44:R -k @48:- -k @56:R -k @60:-
-w "settings: row 24"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:-
-w "settings: row 27"
-k @8:A -k @12:-
-w "screen ready: saves"
-s @4:list.png
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:-
-s @50:empty-row.png
-k @60:A -k @64:-
-s @90:message.png
-k @100:A -k @104:-
-k @120:B -k @124:-
-w "screen ready: settings"
-s @30:back.png
