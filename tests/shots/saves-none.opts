# Settings > Saves > Clean up saves in the light theme with nothing to fix:
# the card's saves belong to games that are there ("Every save has its
# game."), and the trash is empty: Empty trash, its only row, is dimmed, the
# hints offer only B, and A does nothing.
#! settings 28=1
#! sd-file "/torii/saves/Games/Idle.gba/Main.sav" 0x2000 /dev/null
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:A -k @28:-
-w "screen ready: settings"
-k @8:R -k @12:- -k @20:R -k @24:- -k @32:R -k @36:-
-w "settings: row 13"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:-
-w "settings: row 16"
-k @8:A -k @12:-
-w "screen ready: saves"
-s @4:list.png
-k @60:A -k @64:-
-k @120:B -k @124:-
-w "screen ready: settings"
-s @30:back.png
