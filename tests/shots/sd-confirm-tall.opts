# The SD card page with an addon on (B18): a game's popup has eight items,
# so Delete's confirmation has no room for its tiles over it: the popup
# closes first (source/ui/ui_popup.c), and B comes back to the page.
#! settings 1=1
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:LEFT -k @28:- -k @32:LEFT -k @36:- -k @40:A -k @44:-
-w "sdcard: ready /"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @28:START -k @32:-
-w "sdcard: popup"
-s @12:popup.png
-k @20:UP -k @24:- -k @32:UP -k @36:- -k @44:A -k @48:-
-s @70:confirm.png
-k @80:B -k @84:-
-s @110:back.png
-k @120:START -k @124:-
-w "sdcard: popup"
-s @12:again.png
