# The SD card page with an addon on (B18): a game's popup with Play's
# « » boot and Saves (seven items), and Delete's confirmation over it, which
# borrows the popup's tiles if BG block 0 has no room for its own
# (source/ui/ui_popup.c); B (Cancel) brings the popup back, drawn again; B
# closes it and START opens it again.
#! settings 1=1
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:LEFT -k @28:- -k @32:LEFT -k @36:- -k @40:A -k @44:-
-w "sdcard: ready /"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @28:START -k @32:-
-w "sdcard: popup"
-s @12:popup.png
-k @20:UP -k @24:- -k @44:A -k @48:-
-s @70:confirm.png
-k @80:B -k @84:-
-s @110:back.png
-k @114:B -k @118:-
-k @140:START -k @144:-
-w "sdcard: popup"
-s @12:again.png
