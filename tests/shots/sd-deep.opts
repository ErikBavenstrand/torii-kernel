# A deep scroll (folder Games, 301 files): RIGHT pages twenty times, then
# DOWN held for two seconds runs at full speed
-w "screen ready: sd-list"
-k @8:DOWN -k @12:-
-k @20:A -k @24:-
-w "screen ready: sd-list"
-k @8:RIGHT -k @12:- -k @16:RIGHT -k @20:- -k @24:RIGHT -k @28:- -k @32:RIGHT -k @36:-
-k @40:RIGHT -k @44:- -k @48:RIGHT -k @52:- -k @56:RIGHT -k @60:- -k @64:RIGHT -k @68:-
-k @72:RIGHT -k @76:- -k @80:RIGHT -k @84:- -k @88:RIGHT -k @92:- -k @96:RIGHT -k @100:-
-k @104:RIGHT -k @108:- -k @112:RIGHT -k @116:- -k @120:RIGHT -k @124:- -k @128:RIGHT -k @132:-
-k @136:RIGHT -k @140:- -k @144:RIGHT -k @148:- -k @152:RIGHT -k @156:- -k @160:RIGHT -k @164:-
-s @190:paged.png
-k @200:DOWN -k @320:-
-s @360:held.png
