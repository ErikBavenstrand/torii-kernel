# A name past 99 bytes (folder Long, second entry): it lists cut with "...",
# scrolls once the cursor rests on it, and opens whole in the game menu
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:-
-k @28:A -k @32:-
-w "screen ready: sd-list"
-k @8:DOWN -k @12:-
-s @20:start.png
-s @200:scrolled.png
-k @210:A -k @214:-
-w "screen ready: file-menu"
-s @1:menu.png
