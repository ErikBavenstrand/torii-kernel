# An animation: a name too long for its row scrolls once the cursor rests on it
# (folder Long). Every frame is hashed; PNGs only of the first and last.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:-
-k @28:A -k @32:-
-w "screen ready: sd-list"
-H @1:@120
-s @1:start.png
-s @120:scrolled.png
