# R from the SD list with the cursor on Hello.gba (row 5), then L from the
# NOR list: the SD list comes back with the cursor where it was (it came back
# at its first row before v0.3.2). B from Recently Played does the same.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:R -k @48:-
-w "screen ready: nor-list"
-k @8:L -k @12:-
-w "screen ready: sd-list"
-s @1:back.png
-k @8:START -k @12:-
-w "screen ready: recent"
-k @8:B -k @12:-
-w "screen ready: sd-list"
-s @1:recent-back.png
