#! settings 28=2
#! sd-theme example
#! theme-choice example
# BACK UP SAVE's progress dialog shows under the example SD theme's
# wallpaper (v0.3.2: it couldn't get VRAM and never showed). Hello.gba,
# below the card's torii folder, goes to the NOR (WRITE TO NOR CLEAN); then
# the NOR list (where the write leaves the menu), A on it, and BACK UP
# SAVE, the menu's fifth row.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @40:DOWN -k @44:-
-k @52:A -k @56:-
-w "screen ready: file-menu"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:A -k @36:-
-w "nor: list saved"
-w "screen ready: nor-list"
-k @8:A -k @12:-
-k @30:DOWN -k @34:- -k @42:DOWN -k @46:- -k @54:DOWN -k @58:- -k @66:DOWN -k @70:-
-k @78:A -k @82:-
-w "screen ready: progress"
-s @1:progress.png
-w "screen ready: dialog"
-s @10:saved.png
