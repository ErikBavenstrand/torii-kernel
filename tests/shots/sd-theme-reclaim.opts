#! settings 28=2
#! sd-theme bigwall tests/themes/bigwall
#! theme-choice bigwall
# An SD theme with the largest wallpaper (tests/themes/bigwall): the SD list
# leaves it room, a question over the list takes that room for its text, so
# it shows no wallpaper behind it, and the wallpaper is back once B closes the
# question (T18). L+START on Hello.gba, below the card's torii folder, asks
# before deleting it.
-w "screen ready: sd-list"
-s @20:list.png
-k @28:DOWN -k @32:- -k @36:DOWN -k @40:- -k @44:DOWN -k @48:- -k @52:DOWN -k @56:-
-k @60:DOWN -k @64:-
-k @72:L -k @76:L+START -k @80:-
-w "screen ready: dialog"
-s @20:dialog.png
-k @28:B -k @32:-
-w "screen ready: sd-list"
-s @20:kept.png
