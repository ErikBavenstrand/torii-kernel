#! settings 28=2
#! sd-theme wall128 tests/themes/wall128
#! theme-choice wall128
# An SD theme with a 128-tile wallpaper (tests/themes/wall128): the SD list
# leaves it room in VRAM only character block 0 reaches; a question over the
# list takes that room for its text, so the wallpaper moves among the maps
# and still shows behind it, dimmed; once B closes the question it moves
# back (T18). L+START on Hello.gba, below the card's torii folder, asks
# before deleting it.
-w "screen ready: sd-list"
-s @20:list.png
-k @28:DOWN -k @32:- -k @36:DOWN -k @40:- -k @44:DOWN -k @48:- -k @52:DOWN -k @56:-
-k @60:DOWN -k @64:-
-k @72:L -k @76:L+START -k @80:-
-w "screen ready: dialog"
-s @20:dialog.png
-k @28:B -k @32:-
-s @70:kept.png
