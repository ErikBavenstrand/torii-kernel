# A wrap in a long folder (Long, 302 files): UP on its first row goes to the
# last, a page change, and DOWN there wraps back to the top. lists-page
# measures the frames of each (tests/perf/budget.txt)
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:-
-k @28:A -k @32:-
-w "screen ready: sd-list"
-k @8:UP -k @12:-
-s @30:end.png
-k @40:DOWN -k @44:-
-s @70:top.png
