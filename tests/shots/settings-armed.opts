# Save states on (C5): Back to menu shows On whatever it stores, its
# explanation says the in-game menu takes the keys, and A doesn't edit it
# (the page reached from home, R to the Hotkeys section).
#! settings 2=1
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:A -k @28:-
-w "nav: page settings ready"
-k @8:R -k @12:- -k @20:R -k @24:- -k @32:R -k @36:- -k @44:R -k @48:-
-w "settings: row 20"
-s @8:armed.png
-k @12:A -k @16:- -k @24:RIGHT -k @28:-
-s @40:after-a.png
