# The Settings page in dark (the default theme): Dim screen edited in place
# (« 10 min »), and Cart with the LED colour (White) selected over the
# hotkeys' chips (mockups-b16-b18.md, settings-dark.png). Then Theme
# previewed live: the first RIGHT switches the page to light at once, B
# puts dark back.
-w "nav: home ready"
-k @8:UP -k @12:- -k @16:UP -k @20:- -k @24:A -k @28:-
-w "screen ready: settings"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-w "settings: row 3"
-k @8:A -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:- -k @44:RIGHT -k @48:- -k @56:RIGHT -k @60:-
-s @72:dim.png
-k @76:B -k @80:- -k @88:R -k @92:- -k @100:R -k @104:- -k @112:R -k @116:-
-w "settings: row 12"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-w "settings: row 15"
-s @8:cart.png
-k @12:L -k @16:- -k @24:L -k @28:- -k @36:L -k @40:- -k @48:L -k @52:-
-w "settings: row 0"
-k @8:A -k @12:- -k @20:RIGHT -k @24:-
-s @32:theme.png
-k @36:B -k @40:-
-s @48:back.png
