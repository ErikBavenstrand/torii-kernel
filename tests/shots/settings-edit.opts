# SETTINGS page 2's edits open on the value, not on OK: A on SAVE (AUTO
# SAVE) highlights its value, so a second A turns it over; MODE B's opens on
# the mode it has (RUMBLE on a new cart)
-w "screen ready: sd-list"
-k @8:R -k @12:-
-w "screen ready: nor-list"
-k @8:R -k @12:-
-w "screen ready: settings1"
-k @8:R -k @12:-
-w "screen ready: settings2"
-k @8:A -k @12:-
-s @20:save.png
-k @28:A -k @32:-
-s @40:save-turned.png
-k @48:RIGHT -k @52:- -k @60:A -k @64:-
-w "settings: staged"
-k @10:DOWN -k @14:- -k @22:A -k @26:-
-s @34:modeb.png
