# Held L and R turn one page, not more: R held from the NOR list stays on
# SETTINGS page 1, and L held on page 2 stays on page 1 (the engine repeats
# held L and R for lists; SETTINGS takes only the press)
-w "screen ready: sd-list"
-k @8:R -k @12:-
-w "screen ready: nor-list"
-k @8:R
-w "screen ready: settings1"
-s @80:held-r.png
-k @90:-
-k @100:R -k @104:-
-w "screen ready: settings2"
-k @8:L
-w "screen ready: settings1"
-s @80:held-l.png
-k @90:-
