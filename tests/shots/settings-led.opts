# SETTINGS page 2's BREATHING and SD LED are rows of their own while the LED
# is on: DOWN three times reaches BREATHING, A edits it (R, G, B, then OK),
# RIGHT and A turn G over, RIGHT RIGHT and A on OK save it; DOWN then stops
# on SD LED
-w "screen ready: sd-list"
-k @8:R -k @12:-
-w "screen ready: nor-list"
-k @8:R -k @12:-
-w "screen ready: settings1"
-k @8:R -k @12:-
-w "screen ready: settings2"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:- -k @44:A -k @48:-
-k @56:RIGHT -k @60:- -k @68:A -k @72:-
-s @80:edit.png
-k @88:RIGHT -k @92:- -k @100:RIGHT -k @104:- -k @112:A -k @116:-
-w "settings: staged"
-k @10:DOWN -k @14:-
-s @30:saved.png
# The tear watch: no write changes the screen while it scans out
-T 1:99999
