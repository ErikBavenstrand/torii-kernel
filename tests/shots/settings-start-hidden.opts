# Start on set to NES, which the card has no games for (D1): the row still
# reads NES, and the hint bar says power-on falls back to Last place
#! settings 32=8
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:A -k @28:-
-w "screen ready: settings"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-w "settings: row 3"
-s @20:row.png
