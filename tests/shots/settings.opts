# The Settings page (source/screens/settings_page.c, mockups-b16-b18.md) in
# light: the top with Theme selected (#18); Start on edited in place (#19),
# B putting it back; Time's field card (#20) opening (every frame hashed)
# with its hour changed; the LED colour's swatches being chosen; Sleep keys
# waiting for keys, then L+R+START refused (the Reset keys'); and a held
# DOWN from the top through every section to Logging (every frame hashed).
#! settings 28=1
-w "nav: home ready"
-k @8:LEFT -k @12:- -k @16:LEFT -k @20:- -k @24:A -k @28:-
-w "screen ready: settings"
-s @2:top.png
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:-
-w "settings: row 3"
-k @8:A -k @12:- -k @20:RIGHT -k @24:-
-w "settings: row 3 set to"
-s @8:edit.png
-k @12:B -k @16:- -k @24:R -k @28:-
-w "settings: row 5"
-k @12:A -k @16:-
-H @12:@24
-w "screen ready: popup"
-k @4:UP -k @8:- -k @16:RIGHT -k @20:-
-s @30:fields.png
-k @34:B -k @38:- -k @50:R -k @54:- -k @62:R -k @66:-
-w "settings: row 13"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-w "settings: row 16"
-k @8:A -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-s @48:swatch.png
-k @52:B -k @56:- -k @64:R -k @68:-
-w "settings: row 18"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:-
-w "settings: row 21"
-k @8:A -k @12:-
-s @20:capture.png
-k @30:L+R+START -k @60:-
-w "settings: keys refused"
-s @4:refused.png
-k @100:L -k @104:- -k @112:L -k @116:- -k @124:L -k @128:- -k @136:L -k @140:- -k @148:L -k @152:-
-w "settings: row 0"
-k @20:DOWN -k @220:-
-H @20:@240
-s @244:bottom.png
