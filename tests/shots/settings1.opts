# SETTINGS page 1 (R twice), with the pinned clock; then L, held, goes back
# to the NOR list and stays there (the menu mustn't take it as a new press)
-w "screen ready: sd-list"
-k @8:R -k @12:-
-w "screen ready: nor-list"
-k @8:R -k @12:-
-w "screen ready: settings1"
-s @1:screen.png
-k @20:L -k @50:-
-w "screen ready: nor-list"
-s @60:back.png
# The tear watch: no write changes the screen while it scans out
-T 1:99999
