-k @80:A -k @84:-
-k @96:UP -k @100:- -k @112:A -k @116:-
-k @128:UP -k @132:- -k @144:UP -k @148:- -k @160:RIGHT -k @164:- -k @172:RIGHT -k @176:- -k @184:RIGHT -k @188:-
-k @200:A -k @204:-
-s @220:typed.png
