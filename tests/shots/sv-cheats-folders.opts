# cheats-folders.opts in Swedish: lang/sv.ini's pack set in Settings (slot 0, its id
# 0x564E), so every string the scenario shows is Swedish, at its width.
# Headings on the Cheats screen (source/screens/cheats.c, cheatlist.h) over
# tests/shots/data/folders.cht: one flat list, the cheats under no heading
# first (Infinite HP, Walk through walls), then each heading's row (its name
# in the accent, how many are on or how many it holds at the right) over its
# cheats, their names without the "Items: " prefix, the Item x99 variants
# folded into one choice row with its pick at the right (list). DOWN passes
# the Items heading by, the title naming it, the game faint after it
# (under); A picks Master Ball beside Rare Candy, "2 on" on the heading
# (picked); A on the choice row opens its choices (choices); A on PP Up
# picks it and goes back to the row, PP Up at its right (chosen). R goes
# to the next heading's first row, the heading's row at the top (jump); R
# again to Starter's one run of variants, A opens it (direct), A on Torchic
# picks it (starter). A heading too long for the title: cut at first
# (long), then scrolled to its end once the cursor has rested (scrolled).
# L twice: back to the start of Starter, then of Wild (back).
#! settings 28=1
#! settings 0=22094
#! sd-file /torii/lang/sv.lng 0 dist/lang/sv.lng
#! sd-file /torii/cheats/Hello.cht 0 tests/shots/data/folders.cht
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-s @24:list.png
-k @32:DOWN -k @36:- -k @44:DOWN -k @48:-
-s @72:under.png
-k @80:A -k @84:-
-s @104:picked.png
-k @112:DOWN -k @116:- -k @128:A -k @132:-
-s @160:choices.png
-k @168:DOWN -k @172:- -k @184:A -k @188:-
-s @216:chosen.png
-k @224:R -k @228:-
-s @256:jump.png
-k @264:R -k @268:- -k @284:A -k @288:-
-s @316:direct.png
-k @324:DOWN -k @328:- -k @340:A -k @344:-
-s @372:starter.png
-k @380:R -k @384:-
-s @404:long.png
-s @520:scrolled.png
