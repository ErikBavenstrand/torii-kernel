# cheats-raw.opts in Swedish: lang/sv.ini's pack set in Settings (slot 0, its id
# 0x564E), so every string the scenario shows is Swedish, at its width.
# AnyGBA's raw extensions on the Cheats screen (source/screens/cheats.c,
# docs/research/cheats.md) over tests/shots/data/raw-ext.cht: a code of the
# user's with keyed lines, a pointer write, an OR and a key pointer with no
# offset before the next line (list); SELECT: its page, a code line each,
# '^' and '|' spaced out and a long line wrapped before its key (guide);
# START, Edit: the keypad can't type '[', '^' or '|', and says so (edit).
#! settings 28=1
#! settings 0=22094
#! sd-file /torii/lang/sv.lng 0 dist/lang/sv.lng
#! sd-file /torii/cheats/Hello.cht 0 tests/shots/data/raw-ext.cht
# The tests' hook: lists open on their first row (else a list opens on
# Hello, the game Recent played last)
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-s @16:list.png
-k @24:SELECT -k @28:-
-w "screen ready: cheat-guide"
-s @8:guide.png
-k @16:B -k @20:-
-w "screen ready: cheats"
-k @8:START -k @12:-
-w "screen ready: cheat-menu"
-k @24:DOWN -k @28:- -k @40:A -k @44:-
-s @80:edit.png
