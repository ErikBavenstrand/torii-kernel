# keypad-gb.opts in Swedish: lang/sv.ini's pack set in Settings.
# A GB game's code keypad (source/screens/keypad.c) over tests/shots/data/cheat-gb.cht:
# START, Edit code on the first cheat, a Game Genie code with a compare: hex digits
# and a '-' key where the GBA's has ':', no symbols key, no SELECT hint, the line
# tagged GG and the result line saying what it patches (edit); DOWN twice to the
# function row and A types a '-': the line is too long to read (dash).
#! settings 28=1
#! settings 0=22094
#! sd-file /torii/lang/sv.lng 0 dist/lang/sv.lng
#! sd-file /Cheat.gb 0 tests/shots/data/cheat.gb
#! sd-file /torii/cheats/Cheat.cht 0 tests/shots/data/cheat-gb.cht
# The tests' hook: lists open on their first row
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @16:RIGHT -k @20:- -k @28:A -k @32:-
-w "nav: page gb ready"
-k @16:START -k @20:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-k @8:START -k @12:-
-w "screen ready: cheat-menu"
-k @24:DOWN -k @28:- -k @40:A -k @44:-
-w "screen ready: keypad"
-s @8:edit.png
-k @16:DOWN -k @20:- -k @28:DOWN -k @32:- -k @40:A -k @44:-
-s @60:dash.png
# Save: its name asked (name), START keeps it, and the list shows the code as typed (saved)
-k @70:B -k @74:- -k @100:START -k @104:-
-w "screen ready: rename"
-s @8:name.png
-k @16:START -k @20:-
-w "screen ready: cheats"
-s @24:saved.png
