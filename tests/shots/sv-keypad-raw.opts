# keypad-raw.opts in Swedish: lang/sv.ini's pack set in Settings (slot 0, its id
# 0x564E), so every string the scenario shows is Swedish, at its width.
# The code keypad typing AnyGBA's raw extensions (source/screens/keypad.c,
# docs/research/cheats.md), from Hello's cheat screen's + Add code, in the
# light theme: the key between Line and Del shows the symbol row in the
# digits' place ('[' and '+' turn it back); a keyed line typed, too long for
# the card, scrolled to keep the caret in view, read as VBA and what it
# writes (typed); the symbol key again: the symbol row (symbols). Keys from
# tests/keypad_keys.py.
#! settings 28=1
#! settings 0=22094
#! sd-file /torii/lang/sv.lng 0 dist/lang/sv.lng
# The tests' hook: lists open on their first row (else a list opens on
# Hello, the game Recent played last)
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
-k @8:DOWN -k @12:- -k @20:DOWN -k @24:- -k @32:DOWN -k @36:- -k @44:DOWN -k @48:- -k @56:DOWN -k @60:-
-k @72:A -k @76:-
-w "screen ready: keypad"
