# keypad.opts in Swedish (v0.9): lang/sv.ini's pack set in Settings (slot 0, its
# id 0x564E), so every string the scenario shows is Swedish, at its width.
#! settings 0=22094
#! sd-file /torii/lang/sv.lng 0 dist/lang/sv.lng
# The code keypad (source/screens/keypad.c) from Hello's cheat screen's
# + Add code, in the light theme: empty (1); a CodeBreaker line typed,
# the format detected and what it writes (2); SELECT sets GameShark v1,
# which the line doesn't read in (3); SELECT round to auto again, Line and
# three digits of a second line, then L back to the first: the second
# line isn't a code line's shape (4). Keys from tests/keypad_keys.py.
#! settings 28=1
# The tests' hook: lists open on their first row (else a list opens on
# Hello, the game Recent played last)
-p 30:nav_test_action:2113929225
-w "nav: test hook 9 "
-w "nav: home ready"
-k @8:RIGHT -k @12:-
-k @20:A -k @24:-
-w "nav: page gba ready"
-k @8:RIGHT -k @12:- -k @20:RIGHT -k @24:- -k @32:RIGHT -k @36:-
-k @80:START -k @84:-
-w "screen ready: game-popup"
-k @12:DOWN -k @16:- -k @24:DOWN -k @28:-
-k @48:A -k @52:-
-w "screen ready: cheats"
