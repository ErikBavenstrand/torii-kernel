# Out of the engine for a launch (theme transition leave): CLEAN BOOT of
# Hello.gba fades the menu to black before the launch's progress shows.
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-w "screen ready: file-menu"
-k @8:A -k @12:-
-H @8:@18
-s @10:fading.png
-w "screen ready: progress"
-s @1:progress.png
