# A menu over a screen: the game menu of Hello.gba opens (it fades in, then
# the list dims, while it slides up) and B closes it (backwards); then CHEAT
# opens the cheat screen in its place (deeper) and B comes back to the menu.
# Every frame hashed, PNGs of a few.
#! settings 4=1
-w "screen ready: sd-list"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:-
-k @44:A -k @48:-
-H @44:@62
-s @48:opening.png
-s @52:dimming.png
-w "screen ready: file-menu"
-k @8:B -k @12:-
-H @8:@24
-s @14:closing.png
-k @40:A -k @44:-
-w "screen ready: file-menu"
-k @8:DOWN -k @12:- -k @16:DOWN -k @20:- -k @24:DOWN -k @28:- -k @32:DOWN -k @36:- -k @40:DOWN -k @44:-
-k @52:A -k @56:-
-H @52:@72
-w "screen ready: cheats"
-k @8:B -k @12:-
-H @8:@30
-s @20:menu-back.png
-w "screen ready: file-menu"
-s @1:menu.png
