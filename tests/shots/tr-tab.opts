# Screen transitions sideways (theme transition tab): R from the SD list to
# the NOR list, SETTINGS page 1, page 2 and help, then L back to the SD list,
# all in one engine session. Every frame of each transition is hashed; PNGs
# of the frames halfway out and halfway in.
-w "screen ready: sd-list"
-k @8:R -k @12:-
-H @8:@26
-s @10:sd-out.png
-s @14:nor-in.png
-w "screen ready: nor-list"
-k @8:R -k @12:-
-H @8:@26
-w "screen ready: settings1"
-k @8:R -k @12:-
-H @8:@26
-s @14:settings2-in.png
-w "screen ready: settings2"
-k @8:R -k @12:-
-H @8:@26
-w "screen ready: help"
-k @8:L -k @12:-
-H @8:@26
-s @14:settings2-back.png
-w "screen ready: settings2"
-k @8:L -k @12:-
-w "screen ready: settings1"
-k @8:L -k @12:-
-H @8:@26
-w "screen ready: nor-list"
-k @8:L -k @12:-
-H @8:@26
-w "screen ready: sd-list"
-s @1:sd.png
