#! kernel test
# The UI demo's dialog (tests/kernel/ui_demo.c): A opens a modal dialog
# that slides up over the dimmed list (every frame hashed), and B closes it.
-k 1:L+SELECT
-w "screen ready: ui-demo"
-k @2:- -k @10:DOWN -k @14:-
-k @20:A -k @24:-
-H @20:@40
-w "screen ready: ui-dialog"
-s @1:dialog.png
-k @10:B -k @14:-
-s @20:closed.png
