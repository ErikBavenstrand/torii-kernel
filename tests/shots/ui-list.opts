#! kernel test
# The UI demo's list (tests/kernel/ui_demo.c: the test kernel on the cart with L and SELECT held): 1000
# synthetic items. Two rows down, then R pages, with every frame of the
# spring scroll hashed; the marquee of the long name the cursor lands on;
# then back up, and UP at the top wraps to the end: a page change, drawn
# hidden (every frame hashed).
-k 1:L+SELECT
-w "screen ready: ui-demo"
-k @2:-
-s @3:screen.png
-k @10:DOWN -k @14:- -k @20:DOWN -k @24:-
-k @40:R -k @44:-
-H @40:@64
-s @64:paged.png
-s @180:marquee.png
-k @190:L -k @194:- -k @200:UP -k @204:- -k @210:UP -k @214:-
-k @240:UP -k @244:-
-H @240:@252
-s @270:wrapped.png
# Keys during a page change wait for its page: DOWN at the end wraps to 1
# and A a frame later opens item 1's dialog once the page is up; three L one
# frame apart from item 1 wrap to 1000 and page on to 984.
-k @280:DOWN -k @281:DOWN+A -k @284:-
-s @300:queued-a.png
-k @310:B -k @314:-
-k @330:L -k @331:- -k @332:L -k @333:- -k @334:L -k @335:-
-H @330:@345
-s @360:queued-l.png
# Held R pages every 6 frames after 20 (the cycle budget's held paging)
# and stops at 1000: a held key never wraps (v0.3.2)
-k @370:R -k @440:-
-s @460:held-r.png
