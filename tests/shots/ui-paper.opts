#! kernel test
# The Paper clean widgets (B9) in the UI demo (tests/kernel/ui_demo.c): the
# game list page (title bar, card, 14 px rows with the sprite pill, scroll
# bar, hint bar), then SELECT to the widgets screen (path pills, storage
# bar, section label, 12 px rows with their explanation in the hint bar)
# and the reading view, each in the dark theme; then the light theme
# (START) on the reading view, back round to the list (SELECT) and the
# widgets screen in light.
-k 1:L+SELECT
-w "screen ready: ui-demo"
-k @2:-
-s @3:list-dark.png
-k @10:SELECT -k @14:-
-w "screen ready: ui-widgets"
-s @3:widgets-dark.png
-k @10:DOWN -k @14:-
-s @30:widgets-moved.png
-k @40:SELECT -k @44:-
-w "screen ready: ui-reading"
-s @3:reading-dark.png
-k @10:DOWN -k @14:- -k @20:DOWN -k @24:-
-s @40:reading-scrolled.png
-k @50:START -k @54:-
-s @90:reading-light.png
-k @100:SELECT -k @104:-
-w "screen ready: ui-demo"
-s @3:list-light.png
-k @10:SELECT -k @14:-
-w "screen ready: ui-widgets"
-s @3:widgets-light.png
