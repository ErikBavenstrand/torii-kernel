#! kernel test
# A popup past UI_POPUP_ROWS (tests/kernel/ui_demo.c, START with R held):
# twelve items, seven shown, a thin bar inside the card's right edge. Its
# first item steps its value with LEFT/RIGHT (« default » to « clean »), the
# hint bar showing LEFT/RIGHT only there. DOWN past the seventh scrolls the
# rows (every frame hashed); UP from the first wraps to Delete at the
# bottom.
-k 1:L+SELECT
-w "screen ready: ui-demo"
-k @2:- -k @10:SELECT -k @14:-
-w "screen ready: ui-widgets"
-k @10:SELECT -k @14:-
-w "screen ready: ui-reading"
-k @10:SELECT -k @14:-
-w "screen ready: ui-popup"
-k @20:R -k @26:R+START -k @30:-
-w "screen ready: popup"
-s @1:top.png
-k @10:RIGHT -k @14:-
-w "ui-demo: boot clean"
-s @10:stepped.png
-k @20:DOWN -k @24:- -k @30:DOWN -k @34:- -k @40:DOWN -k @44:- -k @50:DOWN -k @54:-
-k @60:DOWN -k @64:- -k @70:DOWN -k @74:-
-k @80:DOWN -k @84:-
-H @80:@92
-s @96:scrolled.png
-k @100:UP -k @104:- -k @110:UP -k @114:- -k @120:UP -k @124:- -k @130:UP -k @134:-
-k @140:UP -k @144:- -k @150:UP -k @154:- -k @160:UP -k @164:-
-k @180:UP -k @184:-
-s @200:wrapped.png
-k @210:B -k @214:-
-w "ui-demo: long popup picked -1"
